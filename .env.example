# Local-development values only. Replace every secret before deployment.
SPRING_PROFILES_ACTIVE=dev
HTTP_PORT=8080
POSTGRES_DB=billgen
POSTGRES_USER=billgen
POSTGRES_PASSWORD=billgen_dev_only
# A run outside Docker (`mvn spring-boot:run`) authenticates as the PostgreSQL superuser `postgres`
# with password `postgres`, which is what a freshly installed local cluster already has. Name your
# own pair by uncommenting the next two lines: they outrank POSTGRES_USER / POSTGRES_PASSWORD above,
# which exist for the Compose stack. The Compose services ignore these two - the postgres container
# creates the role named in POSTGRES_USER and the application container is told that role explicitly.
# Both lines stay commented rather than left blank on purpose: this file is read as properties, so an
# empty `DB_PASSWORD=` is a blank password, not an unset one, and the fallback would not apply.
# DB_USER=postgres
# DB_PASSWORD=your-local-postgres-password
REDIS_PASSWORD=
APP_DEMO_SEED_ENABLED=true
DEMO_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SESSION_COOKIE_SECURE=false
DB_POOL_SIZE=6
